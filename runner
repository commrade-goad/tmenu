#!/usr/bin/env bash

if [ ! -f path_binary.txt ]; then
    echo "$PATH" | tr ':' '\n' | while read -r dir; do
        [ -d "$dir" ] && find "$dir" -maxdepth 1 -type f -executable -printf '%p\n' 2>/dev/null
    done | sort -u > path_binary.txt
fi

PROG=$(./main < path_binary.txt)
SUCCESS=$?

if [ "$SUCCESS" -ne 0 ]; then
    exit 1
fi

"$PROG" &
